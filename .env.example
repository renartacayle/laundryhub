# =========================================================
# LAUNDRYHUB PRODUCTION CONFIGURATION ENVIRONMENT TEMPLATE
# =========================================================

# Application Base
VITE_APP_ENV=production
VITE_APP_NAME="LAUNDRYHUB"
VITE_APP_VERSION="1.0.0"

# Mode Operasional: 'demo' (Bebas Switch Role) atau 'commercial' (Terkunci PIN/Auth)
VITE_COMMERCIAL_MODE=true

# Database & Backend Cloud (Supabase / PostgreSQL REST API)
# Biarkan kosong untuk mode standalone offline / LocalStorage fallback
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Payment Gateway (Midtrans / Xendit QRIS)
VITE_PAYMENT_GATEWAY_PROVIDER=midtrans
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
VITE_MIDTRANS_IS_PRODUCTION=false
VITE_MERCHANT_QRIS_NMID=ID1020023910291
VITE_MERCHANT_NAME="LAUNDRYHUB EXPRESS"
VITE_MERCHANT_CITY="JAKARTA SELATAN"

# WhatsApp Business / Gateway API (Fonnte / Wablas / Baileys)
VITE_WA_GATEWAY_URL=https://api.fonnte.com/send
VITE_WA_API_TOKEN=your-wa-token-here

# Hardware Thermal Printer Default
VITE_DEFAULT_PRINTER_WIDTH=58mm
VITE_AUTO_CUT_PAPER=true
